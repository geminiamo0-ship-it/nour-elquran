{
  "name": "noor-al-quran",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @noor/web dev",
    "lint": "eslint apps/web/src scripts tests && node scripts/check-architecture.mjs",
    "typecheck": "pnpm --filter @noor/web typecheck",
    "test": "node --test tests/*.test.mjs && pnpm --filter @noor/web test",
    "build": "pnpm --filter @noor/web build",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write apps/web/src apps/web/*.ts scripts tests",
    "format:check": "prettier --check apps/web/src apps/web/*.ts scripts tests"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.0",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.0.18"
  }
}
