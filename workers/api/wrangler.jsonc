{
  // LOCAL ONLY. Real IDs/bindings are provisioned in #46, never inferred from this file.
  "name": "noor-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {"bindings": [{"name": "LESSON_ROOMS", "class_name": "LessonRoom"}]},
  "migrations": [{"tag": "classroom-do-v1", "new_sqlite_classes": ["LessonRoom"]}],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "noor-core-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
